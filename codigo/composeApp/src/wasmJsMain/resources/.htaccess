# Book Room web: tipos y caché para servidores Apache
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm application/javascript text/html application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|png|jpg|ttf|xml)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index\.html|bookroom\.js|sw\.js|config\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
